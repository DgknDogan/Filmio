{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Secrets come from env.json, which is gitignored. Copy env.example.json
    // to env.json and fill in your TMDB token before running.
    //
    // A run that names no environment is a dev run on the emulators, so start
    // them first — `firebase emulators:start --project demo-filmio` — or pick
    // one of the configurations below. docs/firebase-environments.md has the
    // detail.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "filmio",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (dev project, no emulators)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--dart-define=USE_FIREBASE_EMULATOR=false",
                "--dart-define=FLAVOR=dev",
                "--flavor",
                "dev"
            ]
        },
        {
            // The production project: real accounts, real liked lists. Nothing
            // here is reversible, so this is a deliberate choice rather than
            // the default.
            "name": "filmio (PRODUCTION data)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--dart-define=USE_FIREBASE_EMULATOR=false",
                "--dart-define=FLAVOR=prod",
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "filmio (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        }
    ]
}
