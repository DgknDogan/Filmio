    //
    // Secrets come from env.json, which is gitignored. Copy env.example.json
    // to env.json and fill in your TMDB token before running.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "filmio",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        }
    ]
}
