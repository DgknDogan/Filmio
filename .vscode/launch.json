{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Secrets come from env.json, which is gitignored. Copy env.example.json
    // to env.json and fill in your TMDB token before running.
    //
    // A run that names no environment is a dev run on the emulators, so start
    // them first — `firebase emulators:start --project demo-filmio`.
    //
    // `--flavor` is Android-only here. Android has product flavors and will
    // not build without one; iOS resolves the Runner scheme when no flavor is
    // given and fails on any flavor until Xcode has a scheme of that name,
    // which it does not yet — docs/firebase-environments.md has those steps.
    // That is why these come in pairs.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "filmio (iOS · emulators)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (Android · emulators)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--flavor",
                "dev"
            ]
        },
        {
            // The production project: real accounts, real liked lists, real
            // watchlists. Nothing here is reversible, so this is a deliberate
            // choice rather than the default.
            "name": "filmio (iOS · PRODUCTION data)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--dart-define=FLAVOR=prod",
                "--dart-define=USE_FIREBASE_EMULATOR=false"
            ]
        },
        {
            "name": "filmio (Android · PRODUCTION data)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--dart-define=FLAVOR=prod",
                "--dart-define=USE_FIREBASE_EMULATOR=false",
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "filmio (iOS · profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        },
        {
            "name": "filmio (iOS · release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=env.json"
            ]
        }
    ]
}
