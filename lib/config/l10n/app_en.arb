  "privacyTitle": "Privacy Policy",
  "@privacyTitle": { "description": "Title of the privacy policy screen" },
  "privacyUpdated": "Last updated 24 August 2026",
  "@privacyUpdated": { "description": "When the policy was last changed" },
  "privacyIntro": "Filmio is a catalogue for browsing films and series. This policy explains what the app stores about you, why, and how to get rid of it.",
  "@privacyIntro": { "description": "Opening paragraph of the privacy policy" },
  "privacyCollectTitle": "What we collect",
  "@privacyCollectTitle": { "description": "Heading of the data collection section" },
  "privacyCollectBody": "When you create an account we store your e-mail address, the display name you choose, and which of the app's built-in avatars you pick. As you use the app we store the films and series you like, against an account identifier issued by Firebase Authentication. That is everything. Filmio asks for no access to your location, contacts, photos, camera, or microphone, and contains no analytics or advertising software.",
  "@privacyCollectBody": { "description": "Body of the data collection section" },
  "privacyUseTitle": "What it is used for",
  "@privacyUseTitle": { "description": "Heading of the data use section" },
  "privacyUseBody": "Your e-mail address and password identify you when you sign in. Your name and avatar appear on your own account screen. Your liked titles fill your lists and feed the recommendations on the home screen. None of it is used for advertising, profiling, or sold to anyone.",
  "@privacyUseBody": { "description": "Body of the data use section" },
  "privacyShareTitle": "Who else sees it",
  "@privacyShareTitle": { "description": "Heading of the data sharing section" },
  "privacyShareBody": "Google Firebase hosts the sign-in service and the database, so your account data is stored on their infrastructure under their own privacy terms. Filmio's recommendation service receives the titles you have liked, so that it can suggest others; it is operated by us and keeps no copy beyond the request. Catalogue data — posters, synopses, ratings, reviews — comes from TMDB, and requests for it carry nothing that identifies you.",
  "@privacyShareBody": { "description": "Body of the data sharing section" },
  "privacyKeepTitle": "How long it is kept",
  "@privacyKeepTitle": { "description": "Heading of the retention section" },
  "privacyKeepBody": "Your data is kept for as long as the account exists. Deleting your account removes the account and everything stored against it immediately and permanently — there is no backup we can restore it from.",
  "@privacyKeepBody": { "description": "Body of the retention section" },
  "privacyRightsTitle": "Your choices",
  "@privacyRightsTitle": { "description": "Heading of the user rights section" },
  "privacyRightsBody": "You can see what is stored about you on the account screen, and you can delete all of it from Settings, under Account removal. If you would rather have a copy of your data, or want anything corrected, write to us and we will answer within thirty days.",
  "@privacyRightsBody": { "description": "Body of the user rights section" },
  "privacyChildrenTitle": "Children",
  "@privacyChildrenTitle": { "description": "Heading of the children section" },
  "privacyChildrenBody": "Filmio is not directed at children under 13 and we do not knowingly collect anything from them. If you believe a child has created an account, write to us and we will remove it.",
  "@privacyChildrenBody": { "description": "Body of the children section" },
  "privacyChangesTitle": "Changes",
  "@privacyChangesTitle": { "description": "Heading of the policy changes section" },
  "privacyChangesBody": "If this policy changes, the new version appears here with a new date. Continuing to use the app after that means the new version applies.",
  "@privacyChangesBody": { "description": "Body of the policy changes section" },
  "privacyContactTitle": "Contact",
  "@privacyContactTitle": { "description": "Heading of the contact section" },
  "privacyContactBody": "Questions about this policy, or about your data, go to:",
